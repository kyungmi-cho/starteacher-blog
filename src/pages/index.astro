---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { catColor, catBg } from '../lib/categories'

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
)

const BASE = import.meta.env.BASE_URL
const postHref = (slug: string) => `${BASE}${slug}/`
const searchHref = (cat: string) => `${BASE}search/?cat=${encodeURIComponent(cat)}`

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`

const counts = new Map<string, number>()
for (const p of all) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1)

// 전체 카테고리(고정) — 콘텐츠 있는 것 먼저, 없는 것은 '준비중'으로 뒤에
const CATE_ORDER = ['공무원', '영어', '유치원', '수능/내신', '취업/자격증']
const withContent = CATE_ORDER.filter((c) => (counts.get(c) ?? 0) > 0)
const extra = [...counts.keys()].filter((c) => !CATE_ORDER.includes(c))
const empty = CATE_ORDER.filter((c) => !(counts.get(c) ?? 0))
const sideCats = [...withContent, ...extra] // 노출 순서: 콘텐츠 보유 우선

// 섹션: 최신 1 / 추천 3 / 전체(최신 제외)
const latest = all[0]
const reco = all.slice(1, 4)
// 전체 글에서 최신 글 제외(중복 방지). 글이 1개뿐이면 최신 글 그대로 노출.
const listItems = all.length > 1 ? all.slice(1) : all
const showHero = all.length > 1 // 글이 1개면 hero 숨겨 중복 방지
---
<BaseLayout
  title="별별정보 - 별별선생"
  description="유치원·어린이집부터 공무원·수능까지, 별별선생이 모은 교육·입시·자격 정보 모음."
>
  <div class="container layout">
    <aside class="sidebar">
      <div class="home">MAIN</div>
      <ul class="cat-list">
        <li><a class="all active" href={BASE}><span>전체글 보기</span><span class="count">{all.length.toLocaleString()}</span></a></li>
        <li class="cat-divider" aria-hidden="true"></li>
        {sideCats.map((c) => (
          <li>
            <a href={searchHref(c)}>
              <span>{c}</span><span class="count">{(counts.get(c) ?? 0).toLocaleString()}</span>
            </a>
          </li>
        ))}
        {empty.length > 0 && (
          <>
            <li class="cat-divider" aria-hidden="true"></li>
            {empty.map((c) => (
              <li><span class="cat-soon">{c} <em>준비중</em></span></li>
            ))}
          </>
        )}
      </ul>

      <a class="side-cta" href="https://www.starteacher.co.kr/" target="_blank" rel="noopener">수강후기 ▶</a>

      <!-- 뉴스레터 구독 -->
      <div class="newsletter">
        <div class="nl-title">별별정보 뉴스레터</div>
        <p class="nl-desc">교육·입시 정보를 매주 이메일로 받아보세요.</p>
        <form class="nl-form" onsubmit="event.preventDefault(); this.querySelector('.nl-done').style.display='block'; this.querySelector('input').value='';">
          <input type="email" required placeholder="이메일 주소" aria-label="이메일 주소" />
          <button type="submit">구독</button>
        </form>
        <p class="nl-done" style="display:none;">구독 신청이 접수되었습니다. (데모)</p>
        <p class="nl-note">* 실제 발송은 메일 서비스 연동 후 동작합니다.</p>
      </div>
    </aside>

    <div class="feed">
      {showHero && latest && (
        <section class="section">
          <h2>방금 올라온 글</h2>
          <a class="hero-card" href={postHref(latest.slug)}>
            {latest.data.heroImage
              ? <img class="thumb" src={latest.data.heroImage} alt={latest.data.heroImageAlt} loading="lazy" />
              : <div class="thumb"></div>}
            <div class="body">
              <span class="cat" style={`color:${catColor(latest.data.category)};background:${catBg(latest.data.category)}`}>{latest.data.category}</span>
              <h3>{latest.data.title}</h3>
              <p>{latest.data.description}</p>
              <time datetime={latest.data.publishedAt.toISOString()}>{fmt(latest.data.publishedAt)}</time>
            </div>
          </a>
        </section>
      )}

      {reco.length > 0 && (
        <section class="section">
          <h2>이런 글은 어때요?</h2>
          <div class="reco-grid">
            {reco.map((p) => (
              <a class="reco-card" href={postHref(p.slug)}>
                {p.data.heroImage
                  ? <img class="thumb" src={p.data.heroImage} alt={p.data.heroImageAlt} loading="lazy" />
                  : <div class="thumb"></div>}
                <div class="body">
                  <span class="cat" style={`color:${catColor(p.data.category)};background:${catBg(p.data.category)}`}>{p.data.category}</span>
                  <h3>{p.data.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="section">
        <h2>{showHero ? '전체 글' : '별별정보 글'}</h2>
        {listItems.length === 0 ? (
          <div class="empty">아직 발행된 글이 없습니다. 첫 글을 추가해 보세요.</div>
        ) : (
          listItems.map((p) => (
            <article class="list-item">
              <a href={postHref(p.slug)}>
                {p.data.heroImage
                  ? <img class="thumb" src={p.data.heroImage} alt={p.data.heroImageAlt} loading="lazy" />
                  : <div class="thumb"></div>}
              </a>
              <div class="body">
                <span class="cat" style={`color:${catColor(p.data.category)};background:${catBg(p.data.category)}`}>{p.data.category}</span>
                <h3><a href={postHref(p.slug)}>{p.data.title}</a></h3>
                <p>{p.data.description}</p>
                <time datetime={p.data.publishedAt.toISOString()}>{fmt(p.data.publishedAt)}</time>
              </div>
            </article>
          ))
        )}
      </section>
    </div>
  </div>
</BaseLayout>
