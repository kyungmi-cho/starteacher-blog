---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { catColor, catBg, catSlug, CATE_ORDER } from '../lib/categories'
import { fmtDate, postThumb, readingMinutes } from '../lib/blog'

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
)

const BASE = import.meta.env.BASE_URL
const postHref = (slug: string) => `${BASE}${slug}/`
const catHref = (cat: string) => `${BASE}category/${catSlug(cat)}/`
const tagHref = (t: string) => `${BASE}tag/${encodeURIComponent(t)}/`

const counts = new Map<string, number>()
for (const p of all) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1)

const withContent = CATE_ORDER.filter((c) => (counts.get(c) ?? 0) > 0)
const extra = [...counts.keys()].filter((c) => !CATE_ORDER.includes(c))
const empty = CATE_ORDER.filter((c) => !(counts.get(c) ?? 0))
const sideCats = [...withContent, ...extra]

// 인기 태그(상위 8개)
const tagCount = new Map<string, number>()
for (const p of all) for (const t of p.data.tags ?? []) tagCount.set(t, (tagCount.get(t) ?? 0) + 1)
const topTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8).map(([t]) => t)

const latest = all[0]
const reco = all.slice(1, 4)
const listItems = all.length > 1 ? all.slice(1) : all
const showHero = all.length > 1

const minutesOf = (p: any) => readingMinutes(p.body ?? '')
const thumbOf = (p: any) => postThumb(p.data.heroImage, p.data.category, p.slug)
---
<BaseLayout
  title="별별정보 - 별별선생"
  description="유치원·어린이집부터 공무원·수능까지, 별별선생이 모은 교육·입시·자격 정보 모음."
>
  <div class="container layout">
    <aside class="sidebar">
      <a class="home" href={BASE}>MAIN</a>
      <ul class="cat-list">
        <li><a class="all active" href={BASE}><span>전체글 보기</span><span class="count">{all.length.toLocaleString()}</span></a></li>
        <li class="cat-divider" aria-hidden="true"></li>
        {sideCats.map((c) => (
          <li>
            <a href={catHref(c)}>
              <span class="dot" style={`background:${catColor(c)}`}></span>
              <span class="name">{c}</span><span class="count">{(counts.get(c) ?? 0).toLocaleString()}</span>
            </a>
          </li>
        ))}
        {empty.length > 0 && (
          <>
            <li class="cat-divider" aria-hidden="true"></li>
            {empty.map((c) => (
              <li><a class="soon" href={catHref(c)}><span class="name">{c}</span><em>준비중</em></a></li>
            ))}
          </>
        )}
      </ul>

      {topTags.length > 0 && (
        <div class="side-tags">
          <div class="side-h">인기 태그</div>
          <div class="tag-cloud">
            {topTags.map((t) => <a href={tagHref(t)}>#{t}</a>)}
          </div>
        </div>
      )}

      <a class="side-cta" href="https://www.starteacher.co.kr/" target="_blank" rel="noopener">수강후기 ▶</a>

      <div class="newsletter">
        <div class="nl-title">별별정보 뉴스레터</div>
        <p class="nl-desc">교육·입시 정보를 매주 이메일로 받아보세요.</p>
        <form class="nl-form" onsubmit="event.preventDefault(); this.querySelector('.nl-done').style.display='block'; this.querySelector('input').value='';">
          <input type="email" required placeholder="이메일 주소" aria-label="이메일 주소" />
          <button type="submit">구독</button>
        </form>
        <p class="nl-done" style="display:none;">구독 신청이 접수되었습니다. (데모)</p>
        <p class="nl-note">* 실제 발송은 메일 서비스 연동 후 동작합니다.</p>
      </div>
    </aside>

    <div class="feed">
      {showHero && latest && (
        <section class="section">
          <h2 class="sec-title">방금 올라온 글</h2>
          <a class="hero-card" href={postHref(latest.slug)}>
            <img class="thumb" src={thumbOf(latest)} alt={latest.data.heroImageAlt} loading="lazy" />
            <div class="body">
              <div class="meta-row">
                <span class="cat" style={`color:${catColor(latest.data.category)};background:${catBg(latest.data.category)}`}>{latest.data.category}</span>
                {latest.data.series && <span class="series-tag" style={`color:${catColor(latest.data.category)}`}>{latest.data.series.name}</span>}
              </div>
              <h3>{latest.data.title}</h3>
              <p>{latest.data.description}</p>
              <div class="foot"><time datetime={latest.data.publishedAt.toISOString()}>{fmtDate(latest.data.publishedAt)}</time><span>·</span><span>{minutesOf(latest)}분 읽기</span></div>
            </div>
          </a>
        </section>
      )}

      {reco.length > 0 && (
        <section class="section">
          <h2 class="sec-title">이런 글은 어때요?</h2>
          <div class="reco-grid">
            {reco.map((p) => (
              <a class="reco-card" href={postHref(p.slug)}>
                <img class="thumb" src={thumbOf(p)} alt={p.data.heroImageAlt} loading="lazy" />
                <div class="body">
                  <span class="cat" style={`color:${catColor(p.data.category)};background:${catBg(p.data.category)}`}>{p.data.category}</span>
                  <h3>{p.data.title}</h3>
                  <div class="foot"><span>{minutesOf(p)}분 읽기</span></div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="section">
        <div class="sec-head">
          <h2 class="sec-title">{showHero ? '전체 글' : '별별정보 글'}</h2>
          <a class="sec-more" href={`${BASE}search/`}>전체 탐색 →</a>
        </div>
        {listItems.length === 0 ? (
          <div class="empty">아직 발행된 글이 없습니다. 첫 글을 추가해 보세요.</div>
        ) : (
          <div class="post-rows">
            {listItems.map((p) => (
              <article class="list-item">
                <a href={postHref(p.slug)}><img class="thumb" src={thumbOf(p)} alt={p.data.heroImageAlt} loading="lazy" /></a>
                <div class="body">
                  <div class="meta-row">
                    <span class="cat" style={`color:${catColor(p.data.category)};background:${catBg(p.data.category)}`}>{p.data.category}</span>
                    {p.data.series && <span class="series-tag" style={`color:${catColor(p.data.category)}`}>{p.data.series.name}</span>}
                  </div>
                  <h3><a href={postHref(p.slug)}>{p.data.title}</a></h3>
                  <p>{p.data.description}</p>
                  <div class="foot"><time datetime={p.data.publishedAt.toISOString()}>{fmtDate(p.data.publishedAt)}</time><span>·</span><span>{minutesOf(p)}분 읽기</span></div>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>
    </div>
  </div>
</BaseLayout>
