---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { catColor, catBg, catUrl, catSlug } from '../lib/categories'
import { fmtDate, postThumb, readingMinutes, buildToc } from '../lib/blog'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, posts } }))
}

const { post, posts } = Astro.props
const d = post.data

const BASE = import.meta.env.BASE_URL
const postHref = (slug: string) => `${BASE}${slug}/`
const catHref = (cat: string) => `${BASE}category/${catSlug(cat)}/`
const tagHref = (t: string) => `${BASE}tag/${encodeURIComponent(t)}/`

const url = new URL(postHref(post.slug), Astro.site).href
const canonical = d.canonicalUrl ?? url

const cColor = catColor(d.category)
const cBg = catBg(d.category)
const originUrl = d.categoryUrl ?? catUrl(d.category)   // 별별선생 후기 페이지(전환 목적)
const categoryPage = catHref(d.category)                // 블로그 카테고리 페이지(탐색 목적)
const minutes = readingMinutes(post.body ?? '')

// 목차 추출 + 본문에 id 주입 (중간 CTA는 넣지 않음 — 흐름 유지)
const { toc, html: finalBody } = buildToc(post.body ?? '')

// 시리즈 내비(같은 시리즈, order 순)
let seriesPrev = null, seriesNext = null, seriesAll: any[] = []
if (d.series) {
  seriesAll = posts
    .filter((p) => p.data.series && p.data.series.name === d.series!.name)
    .sort((a, b) => (a.data.series!.order) - (b.data.series!.order))
  const pos = seriesAll.findIndex((p) => p.slug === post.slug)
  seriesPrev = pos > 0 ? seriesAll[pos - 1] : null
  seriesNext = pos < seriesAll.length - 1 ? seriesAll[pos + 1] : null
}

// 관련 글: 같은 카테고리 우선, 부족 시 보충
const sameCat = posts.filter((p) => p.slug !== post.slug && p.data.category === d.category)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
const others = posts.filter((p) => p.slug !== post.slug && p.data.category !== d.category)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
const related = [...sameCat, ...others].slice(0, 3)

// 카테고리별 CTA 문구(전환 목적 — 별별선생 후기로 유도). 자연스러운 문장으로.
const CTA_COPY: Record<string, { strong: string; span: string }> = {
  '유치원':      { strong: '우리 동네 유치원·어린이집, 어디가 좋을까요?', span: '별별선생에서 실제 학부모 후기를 확인해 보세요.' },
  '공무원':      { strong: '어떤 공무원 강의가 나에게 맞을까요?', span: '별별선생에서 실제 수강생 후기를 비교해 보세요.' },
  '영어':        { strong: '영어 강의, 후기 보고 고르고 싶다면', span: '별별선생에서 실제 수강생 후기를 확인해 보세요.' },
  '수능/내신':   { strong: '수능·내신 인강, 후기부터 확인하세요', span: '별별선생에서 실제 수강생 후기를 비교해 보세요.' },
  '취업/자격증': { strong: '자격증·취업 강의, 후기로 검증하세요', span: '별별선생에서 실제 수강생 후기를 확인해 보세요.' },
  '외국어':      { strong: '외국어 강의, 후기 보고 결정하세요', span: '별별선생에서 실제 수강생 후기를 확인해 보세요.' },
  '대학원/편입': { strong: '편입·대학원 준비, 후기부터 살펴보세요', span: '별별선생에서 실제 수강생 후기를 확인해 보세요.' },
  '임용/기타고시':{ strong: '임용·고시 강의, 후기로 비교하세요', span: '별별선생에서 실제 수강생 후기를 확인해 보세요.' },
  '교수':        { strong: '들을 만한 강의인지 궁금하다면', span: '별별선생에서 실제 수강생 강의평을 확인해 보세요.' },
}
const ctaText = CTA_COPY[d.category] ?? { strong: '어떤 강의가 좋을지 고민된다면', span: '별별선생에서 실제 수강생 후기를 확인해 보세요.' }

const blogPosting = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: d.title, description: d.description,
  datePublished: d.publishedAt.toISOString(),
  dateModified: (d.updatedAt ?? d.publishedAt).toISOString(),
  ...(d.heroImage ? { image: d.heroImage } : {}),
  keywords: (d.tags ?? []).join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: { '@type': 'Organization', name: '별별선생' },
  publisher: { '@type': 'Organization', name: '별별선생', logo: { '@type': 'ImageObject', url: 'https://d27b8p6cm1t9cq.cloudfront.net/static/images/logo/logo_square_orange.png' } },
}
const faqPage = d.faq && d.faq.length
  ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }
  : null
const jsonLd = faqPage ? [blogPosting, faqPage] : [blogPosting]
---
<BaseLayout title={`${d.title} - 별별선생`} description={d.description} canonical={canonical} ogImage={d.heroImage} ogType="article" jsonLd={jsonLd}>
  <div id="progress" class="read-progress" style={`background:${cColor}`}></div>

  <article class="post">
    <header class={d.heroImage ? 'post-hero has-img' : 'post-hero'} style={d.heroImage ? `--band:${cColor}` : `background:${cBg};--band:${cColor}`}>
      {d.heroImage && <img class="hero-bg" src={d.heroImage} alt={d.heroImageAlt} />}
      {d.heroImage && <div class="hero-overlay"></div>}
      <div class="hero-inner">
        <nav class="crumb"><a href={BASE}>별별정보</a> <span>›</span> <a href={catHref(d.category)}>{d.category}</a></nav>
        <h1>{d.title}</h1>
        <div class="meta">
          <time datetime={d.publishedAt.toISOString()}>{fmtDate(d.publishedAt)}</time>
          <span>·</span><span>{minutes}분 읽기</span>
          {d.series && <><span>·</span><span class="series-badge">{d.series.name} 시리즈</span></>}
        </div>
      </div>
    </header>

    <div class="post-grid">
      <!-- 본문 -->
      <div class="article-body" set:html={finalBody}></div>

      <!-- 목차(데스크톱 우측 고정) -->
      {toc.length > 1 && (
        <aside class="toc">
          <div class="toc-title">목차</div>
          <nav>
            {toc.map((t) => (
              <a href={`#${t.id}`} class={t.level === 3 ? 'lv3' : 'lv2'} data-id={t.id}>{t.text}</a>
            ))}
          </nav>
        </aside>
      )}
    </div>

    <div class="post-foot">
      <!-- 태그 -->
      {(d.tags && d.tags.length > 0) && (
        <div class="tag-row">
          {d.tags.map((t) => <a href={tagHref(t)} class="tag-pill">#{t}</a>)}
        </div>
      )}

      <!-- 시리즈 내비 -->
      {d.series && seriesAll.length > 1 && (
        <div class="series-nav">
          <div class="sn-title" style={`color:${cColor}`}>📚 {d.series.name} 시리즈</div>
          <div class="sn-links">
            {seriesPrev
              ? <a href={postHref(seriesPrev.slug)}>← 이전 편<br /><strong>{seriesPrev.data.title}</strong></a>
              : <span class="sn-empty">이 시리즈의 첫 편</span>}
            {seriesNext
              ? <a class="next" href={postHref(seriesNext.slug)}>다음 편 →<br /><strong>{seriesNext.data.title}</strong></a>
              : <span class="sn-empty">이 시리즈의 마지막 편</span>}
          </div>
        </div>
      )}

      <!-- 하단 CTA -->
      <div class="cta-banner" style={`background:${cColor}`}>
        <div class="txt"><strong>{ctaText.strong}</strong><span>{ctaText.span}</span></div>
        <a href={originUrl} target="_blank" rel="noopener" style={`color:${cColor}`}>후기 확인하기 →</a>
      </div>

      <div class="origin-link">
        <span><strong style={`color:${cColor}`}>{d.category}</strong> 카테고리의 다른 글도 이어서 읽어보세요.</span>
        <a href={categoryPage} style={`color:${cColor}`}>더 많은 글 보러가기 →</a>
      </div>

      {related.length > 0 && (
        <section class="related">
          <h2>관련 추천 글</h2>
          <div class="related-grid">
            {related.map((p) => (
              <a class="related-card" href={postHref(p.slug)}>
                <img class="thumb" src={postThumb(p.data.heroImage, p.data.category, p.slug)} alt={p.data.heroImageAlt} loading="lazy" />
                <div class="b">
                  <span class="cat" style={`color:${catColor(p.data.category)};background:${catBg(p.data.category)}`}>{p.data.category}</span>
                  <h3>{p.data.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>

  <style>
    /* 폭 기준: 본문 읽기폭 + 하단/헤더는 조금 더 넓게 */
    .post { --post-width: 760px; --post-wide: 920px; --post-pad: 20px; }

    .read-progress { position:fixed; top:0; left:0; height:3px; width:0; z-index:60; transition:width .1s linear; }

    /* ===== 상단 헤더 밴드 (전체폭) ===== */
    .post-hero { position:relative; overflow:hidden; padding-block:44px; margin-bottom:36px; }
    .post-hero .hero-inner { position:relative; z-index:2; max-width:var(--post-wide); margin:0 auto; padding-inline:var(--post-pad); }
    .post-hero .crumb { font-size:13px; margin-bottom:14px; }
    .post-hero .crumb a { color:var(--band); font-weight:600; }
    .post-hero .crumb span { margin:0 4px; color:var(--muted-foreground); }
    .post-hero h1 { margin:0 0 14px; font-size:30px; font-weight:800; line-height:1.35; letter-spacing:-0.5px; text-align:left; }
    .post-hero .meta { display:flex; align-items:center; gap:8px; flex-wrap:wrap; font-size:13px; color:var(--muted-foreground); }
    .post-hero .series-badge { font-weight:600; color:var(--band); }

    /* 이미지 배경형 */
    .post-hero.has-img { padding-block:64px; }
    .post-hero .hero-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; }
    .post-hero .hero-overlay { position:absolute; inset:0; z-index:1; background:linear-gradient(180deg, rgba(0,0,0,.35), rgba(0,0,0,.62)); }
    .post-hero.has-img h1, .post-hero.has-img .meta { color:#fff; }
    .post-hero.has-img .crumb a { color:#fff; }
    .post-hero.has-img .crumb span { color:rgba(255,255,255,.7); }
    .post-hero.has-img .series-badge { color:#fff; }

    /* ===== 본문 + 목차 ===== */
    .post-grid { max-width:var(--post-wide); margin:0 auto; padding-inline:var(--post-pad);
      display:grid; grid-template-columns: minmax(0,1fr) 200px; gap:44px; align-items:start; }
    .post-grid .article-body { max-width:none; margin:0; min-width:0; }
    .toc { position:sticky; top:88px; font-size:13px; border-left:2px solid var(--border); padding-left:14px; }
    .toc-title { font-weight:700; margin-bottom:10px; }
    .toc nav { display:flex; flex-direction:column; gap:8px; }
    .toc nav a { color:var(--muted-foreground); line-height:1.4; }
    .toc nav a.lv3 { padding-left:12px; font-size:12px; }
    .toc nav a:hover, .toc nav a.active { color:var(--primary); text-decoration:none; font-weight:600; }
    @media (max-width:900px){ .post-grid { grid-template-columns:1fr; gap:0; } .toc { display:none !important; } }

    /* ===== 모바일 오버플로 방지 & 폭 정리 ===== */
    .post { overflow-x:hidden; }
    /* 본문 인라인 HTML(원본 글)이 컨테이너를 밀어내지 않도록 강제 폭 제한 */
    :global(.article-body :where(article,section,div,p,ul,ol,h1,h2,h3,h4,figure,img)) { max-width:100% !important; }
    :global(.article-body article) { padding:0 !important; margin:0 !important; }
    :global(.article-body img) { height:auto; }
    /* 표: 인라인 min-width가 있어도 화면을 넘지 않도록 강제 스크롤 블록화 */
    :global(.article-body table) { display:block !important; width:100% !important; max-width:100% !important; min-width:0 !important; overflow-x:auto !important; -webkit-overflow-scrolling:touch; white-space:nowrap; }
    :global(.article-body div[style*="overflow-x"]) { max-width:100% !important; overflow-x:auto; -webkit-overflow-scrolling:touch; }

    @media (max-width:768px){
      .post { --post-wide:100%; --post-width:100%; --post-pad:16px; }
      .post-hero { padding-block:28px; margin-bottom:24px; }
      .post-hero.has-img { padding-block:44px; }
      .post-hero h1 { font-size:23px; line-height:1.4; }
      .post-grid, .post-foot { padding-inline:16px; }
      .post-foot > * { margin-top:24px; }
      .cta-banner { flex-direction:column; align-items:flex-start; gap:12px; padding:20px; }
      .cta-banner a { width:100%; text-align:center; }
      .origin-link { flex-direction:column; align-items:flex-start; gap:8px; }
      .related-grid { grid-template-columns:1fr; }
    }


    /* ===== 하단 존: 시리즈 블록 기준의 넓은 폭으로 통일 ===== */
    .post-foot { max-width:var(--post-wide); margin:0 auto; padding-inline:var(--post-pad); }
    .post-foot > * { margin-top:32px; }
    .post-foot .tag-row { display:flex; flex-wrap:wrap; gap:8px; margin-top:36px; }
    .tag-pill { font-size:13px; padding:6px 12px; border-radius:999px; background:var(--muted); color:var(--muted-foreground); }
    .tag-pill:hover { background:var(--secondary); color:var(--primary); text-decoration:none; }

    .series-nav .sn-title { font-size:15px; font-weight:700; margin-bottom:12px; }
    .sn-links { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .sn-links a, .sn-links .sn-empty { border:1px solid var(--border); border-radius:var(--radius-lg); padding:14px 16px; font-size:13px; color:var(--muted-foreground); line-height:1.5; }
    .sn-links a strong { color:var(--foreground); font-size:14px; }
    .sn-links a:hover { border-color:var(--primary); text-decoration:none; }
    .sn-links .next { text-align:right; }
    .sn-links .sn-empty { display:flex; align-items:center; justify-content:center; }
    @media (max-width:560px){ .sn-links { grid-template-columns:1fr; } .sn-links .next { text-align:left; } }

    /* 하단 블록들이 post-foot 폭을 꽉 채우도록(기존 max-width 무력화) */
    .post-foot .cta-banner, .post-foot .origin-link, .post-foot .related { max-width:none; margin-left:0; margin-right:0; }
  </style>

  <script>
    // 읽기 진행바
    const bar = document.getElementById('progress')
    const onScroll = () => {
      const h = document.documentElement
      const max = h.scrollHeight - h.clientHeight
      bar.style.width = max > 0 ? `${(h.scrollTop / max) * 100}%` : '0%'
    }
    document.addEventListener('scroll', onScroll, { passive: true }); onScroll()

    // 목차 현재 위치 하이라이트
    const links = [...document.querySelectorAll('.toc nav a')]
    if (links.length) {
      const map = new Map(links.map((a) => [a.dataset.id, a]))
      const targets = links.map((a) => document.getElementById(a.dataset.id)).filter(Boolean)
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove('active'))
            const a = map.get(e.target.id); if (a) a.classList.add('active')
          }
        })
      }, { rootMargin: '-80px 0px -70% 0px' })
      targets.forEach((t) => io.observe(t))
    }
  </script>
</BaseLayout>
