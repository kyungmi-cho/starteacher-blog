---
import '../styles/global.css'
import { catSlug, CATE_ORDER } from '../lib/categories'

// 모든 페이지가 공유하는 껍데기(head + 헤더/푸터).
const {
  title,
  description = '',
  canonical,
  ogImage,
  ogType = 'website',
  jsonLd,           // 문자열(JSON-LD) 또는 배열
} = Astro.props

const siteName = '별별선생'
const base = import.meta.env.BASE_URL
const catHref = (cat: string) => `${base}category/${catSlug(cat)}/`
const searchHref = () => `${base}search/`
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index,follow" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="ko_KR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Pretendard (원본 사이트와 동일 CDN) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css"
    />

    <!-- 구조화 데이터 -->
    {jsonLdList.map((obj) => (
      <script type="application/ld+json" set:html={typeof obj === 'string' ? obj : JSON.stringify(obj)} />
    ))}
  </head>

  <body>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={base} aria-label="별별선생 별별정보 홈">
          <span class="chip">★</span>
          <span>별별선생</span>
        </a>
        <nav class="header-nav" aria-label="카테고리">
          {CATE_ORDER.map((c) => <a href={catHref(c)}>{c}</a>)}
        </nav>
        <span class="header-tag">별별정보</span>
        <a class="header-search" href={searchHref()} aria-label="블로그 내 검색">⌕</a>
        <label for="nav-toggle" class="nav-burger" aria-label="카테고리 메뉴 열기">
          <span></span><span></span><span></span>
        </label>
      </div>
    </header>
    <!-- 모바일 드로어(카테고리) — header 밖에 두어 backdrop-filter 영향 회피 -->
    <label for="nav-toggle" class="nav-scrim" aria-hidden="true"></label>
    <nav class="nav-drawer" aria-label="카테고리 메뉴">
      <div class="drawer-head">
        <span>카테고리</span>
        <label for="nav-toggle" class="drawer-close" aria-label="닫기">✕</label>
      </div>
      {CATE_ORDER.map((c) => <a href={catHref(c)}>{c}</a>)}
      <a class="drawer-search" href={searchHref()}>전체 글 탐색 →</a>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container inner">
        <div class="company">GreyStein Group</div>
        <address>
          서울특별시 강남구 개포로 652, B102 | 대표이사: 황지은 | 사업자등록번호: 134-87-38663<br />
          통신판매업신고번호: 2021-서울강남-04086 | 대표메일: starteacher@greysteingroup.ai<br />
          © GSG. ALL RIGHTS RESERVED.
        </address>
        <nav aria-label="하단 메뉴">
          <a href="https://www.starteacher.co.kr/" target="_blank" rel="noopener">별별선생 홈</a>
          <a href="#">이용약관</a>
          <a href="#">개인정보처리방침</a>
          <a href="#">고객센터</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
